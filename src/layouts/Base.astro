---
import Header from "@/components/Header/Header.astro";
import "@fontsource-variable/cormorant-garamond";
import "@fontsource-variable/mulish";
import "@fontsource/love-ya-like-a-sister";
import "@/styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <script is:inline>
      // Se aplica antes del primer pintado para que el contenido animado no
      // aparezca y desaparezca. Si el módulo de reveal no llegó a ejecutarse
      // (error de red, JS bloqueado), soltamos la clase y todo queda visible.
      document.documentElement.classList.add("reveal-ready");
      setTimeout(() => {
        if (document.documentElement.dataset.revealInit === undefined) {
          document.documentElement.classList.remove("reveal-ready");
        }
      }, 2500);
    </script>
  </head>
  <body>
    <Header />
    <slot />
    <script>
      import "@/scripts/reveal";
    </script>
  </body>
</html>
