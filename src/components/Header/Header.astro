---
import { Image } from "astro:assets";
import Container from "../Container.astro";
import BurgerMenuIcon from "./BurgerMenuIcon.astro";
import CartIcon from "./CartIcon.astro";
import CartCount from "@/components/Cart/CartCount";
import LogoImage from "@/assets/images/logo.png";

const navItemsStyle = "cursor-pointer";
---

<header
  class="fixed top-0 w-full border-b border-line bg-ink-on-dark z-20 mask-b-from-19 xl:mask-b-from-25 text-honey-900"
>
  <Container>
    <nav
      class="flex h-21 xl:h-28 items-center justify-between lg:grid lg:grid-cols-3"
    >
      <BurgerMenuIcon size={30} class="lg:hidden" />
      <ul
        class="hidden lg:flex gap-6 2xl:gap-7 text-xs xl:text-xs 2xl:text-sm xl:font-semibold"
      >
        <li class={navItemsStyle}>Inicio</li>
        <li class={navItemsStyle}>Nosotros</li>
        <li class={navItemsStyle}>Contacto</li>
        <li class={navItemsStyle}>Explorar</li>
      </ul>
      <div class="lg:grid lg:place-content-center">
        <Image
          src={LogoImage}
          alt="Logo de Apiare"
          class="w-18 h-18 2xl:w-22 2xl:h-22"
        />
      </div>
      <a
        href="/carrito"
        class="relative lg:flex lg:justify-end lg:items-center"
      >
        <div class="flex cursor-pointer lg:gap-3">
          <p class="hidden text-sm font-semibold lg:flex">
            CARRITO <CartCount variant="text" client:only="react" />
          </p>
          <CartIcon size={26} />
          <CartCount client:only="react" />
        </div>
      </a>
    </nav>
  </Container>
</header>
