---
import { Image } from "astro:assets";
import BannerContainer from "../BannerContainer.astro";
import Bee from "@/assets/images/bee.png";
import Jar from "@/assets/images/frasco.jpg";
---

<article class="py-0 box-border relative">
  <div id="about" class="absolute -top-30"></div>
  <div class="relative md:h-auto bg-banner py-14 lg:py-11 xl:py-12 2xl:py-14">
    <BannerContainer>
      <div
        class="flex flex-col gap-7 md:gap-0 lg:gap-0 md:grid md:grid-cols-2 lg:grid-cols-[1fr_0.9fr]"
      >
        <div class="flex flex-col gap-9 2xl:gap-9 relative">
          <h1
            data-reveal="left"
            class="text-primary-dark text-base font-bold tracking-wider"
          >
            ¿POR QUÉ ELEGIR MIEL APIARÉ?
          </h1>
          <!-- Línea decorativa del título -->
          <div
            data-reveal="fade"
            data-reveal-delay="260"
            class="absolute w-10 h-px bg-honey-500 top-8 md:top-7 2xl:top-9 left-3 md:left-3 lg:left-3 xl:left-3"
          >
          </div>
          <p
            data-reveal="left"
            data-reveal-delay="140"
            class="text-description-dark font-extralight text-base 2xl:text-base leading-6 xl:leading-7 2xl:leading-8 mb-2 sm:mb-4 md:max-w-sm lg:max-w-md 2xl:max-w-lg"
          >
            Nuestra producción de miel es artesanal y cuenta con un riguroso
            control de calidad para garantizar al consumidor un producto 100%
            puro y natural, elaborado con dedicación para conservar su sabor,
            aroma y todas sus propiedades.
          </p>
        </div>
        <!-- Imágenes -->
        <div class="w-50 md:w-auto h-0 md:h-40 self-end -mt-7 relative">
          <Image
            src={Bee}
            alt="Abeja posada sobre una flor"
            data-reveal="right"
            class="absolute w-34 md:w-50 lg:w-53 xl:w-64 2xl:w-72 h-34 md:h-50 lg:h-53 xl:h-64 2xl:h-72 rounded-full object-cover md:right-15 xl:right-24 2xl:right-29 md:top-7 lg:top-3 xl:-top-6 2xl:-top-14"
          />
          <div
            data-reveal="zoom"
            data-reveal-delay="180"
            class="absolute left-20 md:left-auto -bottom-37 md:-bottom-19 lg:-bottom-23 xl:-bottom-26 md:right-0"
          >
            <!-- El anillo vive en un div propio: reveal.css pisa la `transition`
            de cualquier elemento con data-reveal, así que el hover no puede
            animarse ahí. La foto contrarresta el giro para quedarse quieta. -->
            <div
              class="group rounded-full border-2 border-dashed border-honey-500 p-0.5 xl:p-1 transition-transform duration-700 ease-out-soft hover:rotate-[18deg]"
            >
              <Image
                src={Jar}
                alt="Frasco de vidrio con miel dentro"
                class="w-28 md:w-34 lg:w-40 xl:w-50 h-28 md:h-34 lg:h-40 xl:h-50 rounded-full object-cover transition-transform duration-700 ease-out-soft group-hover:-rotate-[18deg]"
              />
            </div>
          </div>
        </div>
      </div>
    </BannerContainer>
  </div>
</article>

<style>
  .bg-banner {
    background-color:;
    background: url("/hexagons.svg"), var(--color-honey-950);
  }
</style>
