---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Bee from "@/assets/images/bee-decorative.png";
import Container from "../Container.astro";
import AddToCartButton from "@/components/Cart/AddToCartButton";
import { formatPrice } from "@/lib/format";

interface Props {
  products: CollectionEntry<"productos">[];
}

const { products } = Astro.props;

const arrowClass =
  "absolute top-1/2 z-10 grid size-11 -translate-y-1/2 place-items-center rounded-full border border-honey-200/70 bg-honey-25/90 text-honey-700 shadow-card backdrop-blur-sm transition duration-200 ease-out-soft cursor-pointer hover:scale-105 hover:bg-white hover:text-honey-900 hover:shadow-raised focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-honey-500 disabled:pointer-events-none";
---

<section class="flex flex-col mt-24 lg:mt-20 xl:mt-24 gap-2 text-honey-900">
  <Container>
    <div class="flex flex-col gap-3 2xl:gap-8">
      <div class="flex flex-col items-center gap-5 relative">
        <h1
          data-reveal="down"
          class="font-display font-semibold text-lg md:text-2xl lg:text-xl"
        >
          Nuestros Productos
        </h1>
        <div
          data-reveal="fade"
          data-reveal-delay="200"
          class="w-14 h-0.5 absolute top-9 lg:top-11 bg-amber-400"
        >
        </div>
        <Image
          src={Bee}
          alt="Abeja decorativa"
          data-reveal="zoom"
          data-reveal-delay="120"
          class="w-14 md:w-18 lg:w-16"
        />
      </div>

      <div class="mt-10" data-carousel>
        <div class="relative">
          <ul
            data-carousel-track
            data-reveal-stagger="110"
            class="flex gap-6 sm:gap-2 md:gap-0 2xl:gap-0 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-4 scrollbar-none [&::-webkit-scrollbar]:hidden"
          >
            {
              products.map((product) => (
                <li
                  data-reveal="zoom"
                  class="snap-center shrink-0 basis-full sm:basis-1/2 lg:basis-1/3 xl:basis-1/4"
                >
                  <article class="flex flex-col gap-6 rounded-card p-0 h-140 sm:h-137 w-72 sm:w-60 md:w-68 lg:w-56 xl:w-52 2xl:w-56 mx-auto lg:items-center">
                    {/* La imagen es la que cede espacio: flex-1 la deja crecer
                        con lo que sobra y min-h-0 le saca el min-height:auto
                        que, por defecto, impide que un hijo flex se encoja por
                        debajo de su contenido. Sin eso la card se desborda. */}
                    <Image
                      src={product.data.image}
                      alt={product.data.name}
                      class="w-full flex-1 min-h-0 object-cover opacity-80"
                    />
                    {/* shrink-0: el bloque de texto y precio nunca se comprime,
                        así la fila del botón siempre entra en la card. */}
                    <div class="flex shrink-0 flex-col gap-6 lg:gap-6 xl:gap-5">
                      <h3 class="font-body text-md xl:text-sm font-bold lg:max-w-[22ch] tracking-wide">
                        {product.data.name.toUpperCase()}
                      </h3>
                      <p class="text-smq lg:text-sm xl:text-xs leading-6 xl:leading-5">
                        {product.data.description}
                      </p>
                      <div class="flex h-24 shrink-0 border-t border-[#828282] items-center justify-between">
                        <span class="font-semibold text-xl lg:text-lg">
                          {formatPrice(product.data.price)}
                        </span>
                        <AddToCartButton
                          id={product.id}
                          client:load
                          className="text-md lg:text-xs lg:font-light border-2 px-8 lg:px-7 py-3 lg:py-3 tracking-wide cursor-pointer transition hover:bg-honey-500 hover:text-white"
                        />
                      </div>
                    </div>
                  </article>
                </li>
              ))
            }
          </ul>

          <button
            type="button"
            data-carousel-prev
            aria-label="Producto anterior"
            class={`${arrowClass} left-3 disabled:opacity-40 xl:hidden`}
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-5"
              aria-hidden="true"
            >
              <path d="m15 18-6-6 6-6"></path>
            </svg>
          </button>
          <button
            type="button"
            data-carousel-next
            aria-label="Producto siguiente"
            class={`${arrowClass} right-3 disabled:opacity-0 xl:hidden`}
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-5"
              aria-hidden="true"
            >
              <path d="m9 18 6-6-6-6"></path>
            </svg>
          </button>
        </div>

        <div
          class="mt-1 lg:mt-5 xl:mt-0 flex items-center justify-center gap-0"
          data-carousel-dots
        >
          {
            products.map((product, i) => (
              <button
                type="button"
                data-carousel-dot
                aria-current={i === 0 ? "true" : "false"}
                aria-label={`Ir a ${product.data.name}`}
                class="group grid cursor-pointer place-items-center rounded-full p-1.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-honey-500"
              >
                <span class="block h-2 w-2 rounded-full bg-honey-200 transition-all duration-300 ease-out-soft group-hover:bg-honey-400 group-aria-current:w-6 group-aria-current:bg-honey-500" />
              </button>
            ))
          }
        </div>
      </div>
    </div>
  </Container>
</section>

<script>
  import "./carousel";
</script>
