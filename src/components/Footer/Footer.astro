---
import { Image } from "astro:assets";
import Logo from "@/assets/images/logo.png";
import Container from "../Container.astro";
import FooterSection from "./FooterSection.astro";
import FooterBottom from "./FooterBottom.astro";
import PhoneCall from "@/components/icons/PhoneCall.astro";
import Phone from "@/components/icons/Phone.astro";
import Mail from "@/components/icons/Mail.astro";
import Clock from "@/components/icons/Clock.astro";
import MapPin from "@/components/icons/MapPin.astro";
import Users from "@/components/icons/Users.astro";
import Navigation from "@/components/icons/Navigation.astro";
import Facebook from "@/components/icons/Facebook.astro";
import Instagram from "@/components/icons/Instagram.astro";
import Tiktok from "@/components/icons/Tiktok.astro";

const contactItems = [
  { Icon: Phone, text: "(2281) - 376081", href: "tel:+5492281376081" },
  {
    Icon: Mail,
    text: "facundobitar2023@gmail.com",
    href: "mailto:facundobitar2023@gmail.com",
  },
  { Icon: Clock, text: "Lun - Vie: 9:00 - 18:00" },
  { Icon: Clock, text: "Sáb: 9:00 - 13:00" },
];

const socials = [
  { Icon: Facebook, label: "Facebook", href: "#" },
  { Icon: Instagram, label: "Instagram", href: "#" },
  { Icon: Tiktok, label: "TikTok", href: "#" },
];

const navLinks = [
  { text: "Inicio", href: "/#" },
  { text: "Nosotros", href: "/#about" },
  { text: "Productos", href: "/#products" },
  { text: "Contacto", href: "/#contact" },
];
---

<footer class="mt-16 lg:pb-18 xl:pb-8 2xl:pb-16">
  <Container>
    <div
      class="flex justify-center items-start h-46 lg:h-39 border-b border-honey-500"
    >
      <Image
        src={Logo}
        alt="Logo de Apiaré"
        data-reveal="down"
        class="w-36 lg:w-30 2xl:w-34 object-contain"
      />
    </div>
    <div
      data-reveal-stagger="120"
      class="flex flex-col lg:grid lg:grid-cols-4 gap-8 py-10 lg:py-10 2xl:py-14"
    >
      <FooterSection title="Navegación">
        <Navigation slot="icon" size={19} />
        <nav>
          <ul
            class="flex lg:flex-col flex-wrap items-center lg:items-start gap-x-3 gap-y-2 lg:gap-y-4 2xl:gap-y-5 text-sm text-honey-800"
          >
            {
              navLinks.map(({ text, href }, i) => (
                <li class="flex items-center gap-3">
                  <a href={href} class="transition hover:text-honey-600">
                    {text}
                  </a>
                  {i < navLinks.length - 1 && (
                    <span class="text-honey-300 lg:hidden" aria-hidden="true">
                      |
                    </span>
                  )}
                </li>
              ))
            }
          </ul>
        </nav>
      </FooterSection>

      <FooterSection title="Contacto">
        <PhoneCall slot="icon" size={19} />
        <ul class="flex flex-col gap-3 lg:gap-4 2xl:gap-5">
          {
            contactItems.map(({ Icon, text, href }) =>
              href ? (
                <li>
                  <a
                    href={href}
                    class="flex items-center gap-3 text-sm text-honey-800 transition hover:text-honey-600"
                  >
                    <Icon size={18} class="shrink-0 text-honey-500 lg:hidden" />
                    {text}
                  </a>
                </li>
              ) : (
                <li class="flex items-center gap-3 text-sm text-honey-800">
                  <Icon size={18} class="shrink-0 text-honey-500 lg:hidden" />
                  {text}
                </li>
              ),
            )
          }
        </ul>
      </FooterSection>

      <FooterSection title="Ubicación">
        <MapPin slot="icon" size={19} />
        <p class="flex items-center gap-3 text-sm text-honey-800 lg:leading-6">
          <MapPin size={18} class="shrink-0 text-honey-500 lg:hidden" />
          Falucho 308, Benito Juárez.
        </p>
      </FooterSection>

      <FooterSection title="Seguinos">
        <Users slot="icon" size={19} />
        <ul
          class="flex items-center lg:flex-col lg:items-start gap-3 lg:gap-4 2xl:gap-5"
        >
          {
            socials.map(({ Icon, label, href }) => (
              <li>
                <a
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex items-center gap-2 rounded-full transition duration-200 ease-out-soft hover:-translate-y-0.5 active:translate-y-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-honey-500"
                >
                  <span class="grid size-11 lg:size-6 shrink-0 place-items-center rounded-full border lg:border-none border-honey-400 text-honey-500 transition duration-200 ease-out-soft group-hover:border-honey-500 group-hover:bg-honey-500 group-hover:text-honey-25 group-hover:shadow-card lg:group-hover:bg-transparent lg:group-hover:text-honey-600">
                    <Icon size={19} />
                  </span>
                  <span class="hidden lg:block text-sm text-honey-800 transition duration-200 ease-out-soft group-hover:text-honey-600">
                    {label}
                  </span>
                  <span class="sr-only lg:hidden">{label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </FooterSection>
    </div>

    <FooterBottom />
  </Container>
</footer>
