---
import { Image } from "astro:assets";
import Hero from "@/assets/images/hero.png";
---

<section class="py-4 xl:py-5 2xl:py-10 2xl:pb-0">
  <div
    class="@container relative mx-auto flex max-w-2xl 2xl:max-w-3xl justify-center md:pt-2 lg:pt-4 text-honey-900"
  >
    <h1
      data-reveal="down"
      class="absolute top-[-2%] lg:top-[1%] xl:top-[-1%] z-0 text-[15cqw] md:text-[16cqw] font-extrabold leading-none tracking-[0.01rem]
      text-honey-700 mask-b-from-0% xl:px-2"
    >
      HONEY
    </h1>

    <div
      data-reveal="left"
      data-reveal-delay="220"
      class="absolute left-[6%] xl:left-[4%] z-20 hidden h-full flex-col justify-center md:flex text-sm pb-28 pointer-events-none"
    >
      <h2 class="text-sm font-bold leading-[1.45rem] 2xl:leading-[1.55rem]">
        PRODUCTOS DE LA <br /> MEJOR CALIDAD
      </h2>
      <a
        href="#products"
        class="pointer-events-auto py-1.5 w-full bg-honey-400 rounded-full mt-4 flex justify-center gap-1 cursor-pointer transition duration-200 ease-out-soft hover:bg-honey-500 hover:text-honey-25 hover:-translate-y-0.5 hover:shadow-card active:translate-y-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-honey-500"
        >Ver Productos
      </a>
    </div>

    <Image
      src={Hero}
      alt="Imagen hero de la landing page de Apiare"
      data-reveal="zoom"
      data-reveal-delay="80"
      class="relative z-10 h-auto w-full pr-3"
    />

    <div
      data-reveal="right"
      data-reveal-delay="220"
      class="hidden md:flex absolute right-[6%] xl:right-[4%] h-full w-40 flex-col items-end justify-center pb-3"
    >
      <div class="font-display-secondary tracking-wide leading-3">
        <h3 class="text-3xl">MIEL</h3>
        <span>100% pura</span>
      </div>
    </div>
  </div>
</section>
