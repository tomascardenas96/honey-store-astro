---
import Base from "@/layouts/Base.astro";
import CartView from "@/components/Cart/CartView";
import { getCatalog } from "@/lib/catalog";
import Container from "@/components/Container.astro";

// El catálogo se resuelve en el build y viaja como prop a la isla.
// La página sigue siendo estática: la isla solo pone las cantidades encima.
const catalog = await getCatalog();
---

<Base title="Carrito — Apiaré">
  <!-- El header mide h-21 y está fijo: con mt-21 el título quedaba pegado al
  borde. Los 4 de más son el aire, los mismos que usa la ficha de producto. -->
  <main class="mt-25 xl:mt-34 mx-auto pb-section">
    <Container>
      <h1 class="font-display text-3xl" data-reveal="fade">Tu carrito</h1>

      <CartView catalog={catalog} client:only="react" />
    </Container>
  </main>
</Base>
