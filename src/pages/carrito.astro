---
import Base from "@/layouts/Base.astro";
import CartView from "@/components/Cart/CartView";
import { getCatalog } from "@/lib/catalog";

// El catálogo se resuelve en el build y viaja como prop a la isla.
// La página sigue siendo estática: la isla solo pone las cantidades encima.
const catalog = await getCatalog();
---

<Base title="Carrito — Apiaré">
  <main class="mt-25 mx-auto max-w-5xl px-6 pb-section">
    <a
      href="/"
      data-reveal="fade"
      class="inline-flex items-center gap-2 font-body text-sm text-honey-700 transition hover:text-honey-900"
    >
      ← Seguir comprando
    </a>

    <h1 class="mt-8 font-display text-3xl" data-reveal="fade">Tu carrito</h1>

    <CartView catalog={catalog} client:only="react" />
  </main>
</Base>
